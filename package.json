{
  "name": "@averildwi/nest-common",
  "version": "3.1.1",
  "description": "Automated generator to inject a complete common folder into NestJS",
  "main": "bin/scaffold.js",
  "bin": {
    "nest-common": "bin/scaffold.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/unit.test.js test/workspace.test.js test/install.test.js test/package.test.js test/integration.test.js"
  },
  "keywords": [
    "nestjs",
    "scaffold",
    "generator",
    "cli",
    "boilerplate",
    "common",
    "swagger",
    "prisma"
  ],
  "author": "averildwi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averildwi/nest-common.git"
  },
  "bugs": {
    "url": "https://github.com/averildwi/nest-common/issues"
  },
  "homepage": "https://github.com/averildwi/nest-common#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "dependencies": {
    "fs-extra": "^11.3.6",
    "inquirer": "^9.0.0"
  }
}
